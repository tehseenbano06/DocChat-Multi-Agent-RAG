# Default: completely local LLM through Ollama
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# Local embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
TOP_K=5
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5
MAX_TOTAL_SIZE_MB=50

# Optional OpenAI-compatible API mode.
# If you use an API provider instead of Ollama, set:
# LLM_BACKEND=api
# API_BASE_URL=...
# API_KEY=...
# API_MODEL=...
